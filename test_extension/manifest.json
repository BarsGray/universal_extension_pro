
{
  "manifest_version": 3,
  "name": "My Universal Extension",
  "version": "0.0.001",
  "description": "Моё расширение для Chrome и Firefox",

  "permissions": [
    "storage",
    // "activeTab",
    "tabs"
  ],

  "action": {
    "default_title": "My Extension",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
  
  // "host_permissions": [
  //   "<all_urls>"
  // ]
}